{
  "rewrites": [
    {
      "source": "/terms",
      "destination": "/terms/"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/"
    }
  ],
  "trailingSlash": true,
  "headers": [
    {
      "source": "/app-ads.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ],
  "buildCommand": "node scripts/publish-site.mjs",
  "outputDirectory": "_publish",
  "functions": {
    "api/livon/chat.mjs": {
      "maxDuration": 40
    }
  }
}
