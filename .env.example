# Server only. Never use VITE_ or NEXT_PUBLIC_ prefixes.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Required for ALL Vercel environments and NODE_ENV=production. Missing/unavailable => fail closed.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate locally: openssl rand -hex 32
LIVON_RATE_LIMIT_SECRET=
# Site-wide requests per rolling 24 hours; 1..10000. Counts attempts, including failures.
LIVON_DAILY_REQUEST_LIMIT=500
# Optional per-client AI limits (anonymous client = HMAC of the IP, keys expire with their window). Empty → defaults 6/min, 50/day.
LIVON_AI_MINUTE_LIMIT=
LIVON_AI_CLIENT_DAILY_LIMIT=

# LIVON Real Data Layer — 온통청년 청년정책 Open API (server only; /api/livon/data). Leave empty until the key is issued.
YOUTHCENTER_API_KEY=

# LIVON Real Data Layer — 기업마당 지원사업정보 API (server only; /api/livon/data). Leave empty until the key is issued.
BIZINFO_API_KEY=

# LIVON Real Data Layer — Kakao Local 장소 검색 REST API key (server only; /api/livon/data). Leave empty until the key is issued.
KAKAO_REST_API_KEY=

# LIVON Real Data Layer — 한국관광공사 국문 관광정보 서비스(TourAPI) 공공데이터포털 서비스키, Decoding 키 (server only; /api/livon/data). Leave empty until the key is issued.
TOURAPI_SERVICE_KEY=

# LIVON Real Data Layer — 공공데이터포털 일반 인증키(Decoding) for 전국평생학습강좌표준데이터 OpenAPI (server only; /api/livon/data).
# Kept separate from TOURAPI_SERVICE_KEY so each provider's key is explicit (the portal issues one key per account; the same value may be pasted into both).
# Also used by the public 마을세무사 sources (대구 동구 OpenAPI, 인천 자동변환 API) — each API still needs its own 활용신청 on 공공데이터포털.
PUBLIC_DATA_SERVICE_KEY=

# LIVON Real Data Layer — 고용24 OPEN-API 인증키 for 국민내일배움카드 훈련과정 (목록 + 과정/기관정보) (server only; /api/livon/data).
# Issued by 고용24 (기업회원 → OPEN-API 서비스 신청 → 담당자 심사), not by 공공데이터포털. Leave empty until the key is issued.
WORK24_TRAINING_API_KEY=

# LIVON Real Data Layer — (optional, server only) 1 = allow ?action=diagnostics outside production (ids/counters/codes only). Keep empty in production.
LIVON_DATA_DIAGNOSTICS=

# ─────────────────────────────────────────────────────────────────────────────────────────────────────────────
# Newon+ consumer auth (docs/newon/newon-plus-auth-foundation.md). NOT CONFIGURED: leave every value empty.
# While these are empty every Newon web service (LIVON included) runs anonymously; nothing breaks.
# NEVER use the HQ admin project (newon-hq) or the OX MONTH project (newon-oxmonth) here — both are refused.
#
# [PUBLIC · BUILD-TIME] Firebase WEB app config of the future Newon+ project. These values are shipped to every browser
# by design (they identify the project; they are not secrets). scripts/publish-site.mjs writes them into
# _publish/newon-auth/newon-auth-config.js only when ALL four are set.
NEWON_PLUS_FIREBASE_API_KEY=
NEWON_PLUS_FIREBASE_AUTH_DOMAIN=
NEWON_PLUS_FIREBASE_PROJECT_ID=
NEWON_PLUS_FIREBASE_APP_ID=
# session (default) | local | memory — where the Firebase SDK keeps its own sign-in state. Newon code never stores tokens.
NEWON_PLUS_AUTH_PERSISTENCE=
# Sign-in methods ENABLED in that Firebase project (comma-separated: google.com, apple.com). Empty → no sign-in button.
NEWON_PLUS_AUTH_PROVIDERS=
#
# [SERVER ONLY] ID-token verification (server/newon/auth/verify.mjs). Stays "false" until the Newon+ project exists AND an
# official verifier (firebase-admin or a maintained JWKS library) is installed. Verification needs only the PROJECT ID
# (NEWON_PLUS_FIREBASE_PROJECT_ID above) — no service account / private key is required for it, and none belongs in any
# client-visible variable. If a later feature needs Admin credentials, use the hosting platform's secret store, never a
# NEWON_PLUS_FIREBASE_* variable.
NEWON_AUTH_VERIFY_ENABLED=false
# optional, comma-separated; defaults to https://securetoken.google.com/<NEWON_PLUS_FIREBASE_PROJECT_ID>
NEWON_AUTH_ALLOWED_ISSUERS=

# ─────────────────────────────────────────────────────────────────────────────────────────────────────────────
# LIVON live backend (docs/livon/live-backend.md): GitHub Pages frontend + separate Vercel API project.
# [SERVER · Vercel API project] Browser origins allowed to call the API (comma-separated exact https origins, never "*").
# Empty → https://www.newon.app,https://newon.app. localhost is allowed only outside production.
LIVON_ALLOWED_ORIGINS=
# [SERVER · Vercel API project build] 1 = publish only a noindex placeholder instead of a copy of the whole site.
LIVON_API_ONLY=
# [PUBLIC · GitHub Pages build] https origin of the LIVON API (e.g. the Vercel API domain). Set as a repository VARIABLE.
# Empty → same-origin /api (which does not exist on GitHub Pages; LIVON then shows its honest "not connected" states).
LIVON_API_ORIGIN=

# ─────────────────────────────────────────────────────────────────────────────────────────────────────────────
# LIVON account backend & sync (docs/newon/newon-plus-account-backend.md). [SERVER ONLY · Vercel API project]
# The route answers only when ALL of these are true: LIVON_USERDATA_ENABLED=true, LIVON_DATABASE_URL set,
# NEWON_AUTH_VERIFY_ENABLED=true with NEWON_PLUS_FIREBASE_PROJECT_ID, and (in production) Upstash protection.
LIVON_USERDATA_ENABLED=false
# PostgreSQL connection string (secret; pooled URL recommended for serverless). Apply migrations/001 first.
LIVON_DATABASE_URL=
# Optional per-account request limits (defaults 60/min, 3000/day).
LIVON_USERDATA_MINUTE_LIMIT=
LIVON_USERDATA_DAILY_LIMIT=
